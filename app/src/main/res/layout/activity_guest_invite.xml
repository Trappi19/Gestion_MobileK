<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Bandeau -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4A90E2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBackGuest"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Invitation invité"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- Spacer -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Avertissement Wi-Fi -->
            <TextView
                android:id="@+id/tvWifiWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF3E0"
                android:padding="12dp"
                android:textColor="#E65100"
                android:textSize="14sp"
                android:visibility="gone"/>

            <!-- Nom personne -->
            <TextView
                android:id="@+id/tvGuestPersonName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>

            <!-- QR Code -->
            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="QR Code"
                android:layout_marginBottom="12dp"/>

            <!-- Lien texte -->
            <TextView
                android:id="@+id/tvInviteLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:textSize="13sp"
                android:textIsSelectable="true"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp"/>

            <!-- Bouton partager -->
            <Button
                android:id="@+id/btnShareLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Partager le lien"
                android:layout_marginBottom="16dp"/>

            <!-- Statut serveur -->
            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:padding="8dp"
                android:layout_marginBottom="4dp"/>

            <!-- Expiration -->
            <TextView
                android:id="@+id/tvExpiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#757575"
                android:padding="8dp"
                android:layout_marginBottom="4dp"/>

            <!-- Info : garder app ouverte -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gardez l'application ouverte pour recevoir la réponse. L'invité doit être sur le même réseau Wi-Fi."
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:padding="8dp"
                android:layout_marginBottom="12dp"/>

            <!-- Statut réponse -->
            <TextView
                android:id="@+id/tvResponseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <!-- Bouton fusion -->
            <Button
                android:id="@+id/btnMergeGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fusionner les goûts"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
